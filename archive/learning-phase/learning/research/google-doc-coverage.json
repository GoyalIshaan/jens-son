  "high_priority_corrections": [
    {
      "topic": "Pipeline arithmetic",
      "source_claim": "N - 2(S - 1) steady-state steps",
      "correction": "For N jobs and S equal-duration stages: total N+S-1 steps; fully occupied max(0,N-S+1)."
    },
    {
      "topic": "Array mapping",
      "source_claim": "Array K/M/N formulas expressed generally",
      "correction": "Formulas mostly assume weight-stationary geometry and symmetric operand supply; do not transplant into output-stationary models."
    },
    {
      "topic": "Numeric precision",
      "source_claim": "8 or 7 bits always enough",
      "correction": "Conditional on model, quantization, scaling, accumulation, supported operators and quality thresholds."
    },
    {
      "topic": "Structured sparsity",
      "source_claim": "Always beneficial",
      "correction": "Eligible kernel peak is not end-to-end speedup; quality/retraining and metadata matter."
    },
    {
      "topic": "Fixed function",
      "source_claim": "Etched and Taalas support only one burned-in model",
      "correction": "Distinguish architecture specialization from fixed-weight silicon; do not repeat company claims without primary verification."
    },
    {
      "topic": "Topology",
      "source_claim": "Router 50% ceiling vs torus 100%",
      "correction": "A link-budget accounting model, not universal delivered endpoint throughput."
    },
    {
      "topic": "Pipeline KV",
      "source_claim": "No per-chip KV saving from pipeline parallelism",
      "correction": "Depends on holding per-stage batch fixed and increasing concurrency; fixed global concurrency can shard per-request KV by layer."
    },
    {
      "topic": "CUDA concurrency",
      "source_claim": "Different kernels cannot multiplex on one SM",
      "correction": "Concurrent kernels are supported subject to architecture, context and resources; do not assume universal prohibition."
    }
  ]
